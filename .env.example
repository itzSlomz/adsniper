# See build brief Section 13. Never commit real values.
DATABASE_URL=

X_PROVIDER=apify                   # or: twitterapi, socialdata, official
X_PROVIDER_API_KEY=
LINKEDIN_POSTS_PROVIDER_API_KEY=   # e.g. APIFY_TOKEN
META_ADS_PROVIDER_API_KEY=
GOOGLE_ADS_PROVIDER_API_KEY=
LINKEDIN_ADS_PROVIDER_API_KEY=
TIKTOK_ADS_PROVIDER_API_KEY=       # optional; only if Phase 0 go/no-go passes

MONTHLY_COST_CEILING_X_USD=30
MONTHLY_COST_CEILING_LINKEDIN_USD=60
MONTHLY_COST_CEILING_ADS_USD=60

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=
AUTH_PASSCODE=                     # 6-digit fallback while Resend is unset
SEED_ADMIN_EMAIL=                  # seeded as admin on `npm run db:seed`

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
TZ=Asia/Riyadh
