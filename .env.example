# Per-customer AdSniper instance configuration. Never commit real values.
# The provisioning runbook in README.md walks through every value.
DATABASE_URL=

# --- Licensing (vendor-controlled; the customer never edits these) ---
LICENSE_EXPIRES_AT=                # ISO date, e.g. 2027-08-15. Unset = open dev/demo mode
LICENSE_PLAN=                      # optional label shown to admins, e.g. "Standard (yearly)"
LICENSE_FEATURES=                  # comma list of licensed add-ons, e.g. "mentions". Ignored while LICENSE_EXPIRES_AT is unset (dev/demo = every feature on)
VENDOR_CONTACT_EMAIL=              # renewal contact shown when the license expires
CUSTOMER_NAME=                     # default workspace name (admin-editable in Settings)
MARKET_REGION=SA                   # default ISO country for ad-library queries (admin-editable)

# --- Data providers ---
X_PROVIDER=apify                   # or: twitterapi, socialdata, official
X_PROVIDER_API_KEY=
LINKEDIN_POSTS_PROVIDER=apify
LINKEDIN_POSTS_PROVIDER_API_KEY=   # e.g. APIFY_TOKEN
META_ADS_PROVIDER_API_KEY=
GOOGLE_ADS_PROVIDER_API_KEY=
LINKEDIN_ADS_PROVIDER_API_KEY=
ADS_PROVIDERS=meta,google,tiktok   # comma list: meta,google,linkedin,tiktok
TIKTOK_ADS_PROVIDER_API_KEY=       # Creative Center Top Ads (partial coverage)

# Monthly provider-spend ceilings per group; jobs hard-stop when hit.
MONTHLY_COST_CEILING_X_USD=30
MONTHLY_COST_CEILING_LINKEDIN_USD=60
MONTHLY_COST_CEILING_ADS_USD=60
MONTHLY_COST_CEILING_MENTIONS_USD=20
MONTHLY_COST_CEILING_AI_USD=       # unset = no ceiling (unchanged behaviour); covers briefs + the mentions classifier

# --- Media storage (R2 primary, local-disk fallback when unset) ---
# ONE BUCKET PER CUSTOMER, and an API token scoped to that bucket alone —
# so one instance physically cannot read or write another's archive. On a
# bare container filesystem the archive is destroyed on every redeploy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                         # e.g. adsniper-<customer>-media
R2_ENDPOINT=                       # optional: jurisdiction endpoint, another
                                   # S3-compatible provider, or a test server
MEDIA_DIR=                         # only when using a mounted volume instead of R2

# --- Auth ---
RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=
AUTH_TRUST_HOST=true               # required behind Railway/any proxy (Auth.js v5)
AUTH_URL=                          # public URL, e.g. https://ads.customer.com.
                                   # Optional on Railway (derived from
                                   # RAILWAY_PUBLIC_DOMAIN); set it on any other
                                   # host, or sign-in redirects to the container's
                                   # internal address instead of the real domain.
AUTH_PASSWORD=                     # instance password for username sign-in while Resend is unset
SEED_ADMIN_EMAIL=                  # seeded as admin on `npm run db:seed` (contact + magic-link address)
SEED_ADMIN_USERNAME=               # the admin's sign-in handle, e.g. marketingspy — never an email

# --- AI briefings (optional; facts-only fallback when unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Audience conversation (add-on; LICENSE_FEATURES must include "mentions") ---
MENTIONS_LLM=                      # "on" labels posts with Anthropic (needs ANTHROPIC_API_KEY); anything else = posts stay unlabelled
MENTIONS_LLM_MODEL=                # optional classifier model; default claude-sonnet-5 (MENTIONS_DEFAULT_MODEL). Must accept structured outputs — claude-sonnet-4-6 does not. Independent of ANTHROPIC_MODEL
MENTIONS_RETENTION_DAYS=90         # post text + author identifiers erased this many days after posting (1–3650)
# MENTIONS_MAX_CALLS_PER_BRAND_PER_DAY=4
# MENTIONS_MAX_ITEMS_PER_BRAND_PER_DAY=200
# MENTIONS_MAX_ITEMS_PER_CALL=100
# MENTIONS_FIXTURE=1               # VERIFICATION ONLY — never set on a customer instance

TZ=Asia/Riyadh                     # cron times are instance-local
APP_URL=
# ADSNIPER_ENV=staging             # permanent test-copy banner
